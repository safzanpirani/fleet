{
  "name": "fleet",
  "version": "0.1.0",
  "description": "Drive your whole machine fleet over SSH without quoting pain",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fleet": "./src/cli.ts",
    "fleet-mcp": "./src/mcp.ts",
    "fleet-mcp-http": "./src/http.ts"
  },
  "scripts": {
    "fleet": "bun run src/cli.ts",
    "mcp": "bun run src/mcp.ts",
    "serve": "bun run src/http.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsrs --noEmit",
    "check": "bun run typecheck && bun test --timeout 30000",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/cli.ts --outfile dist/fleet-linux-x64",
    "build:local": "bun scripts/build-local.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/bun": "latest",
    "tsrs": "0.16.0-ts7.1.0-dev.20260929",
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1"
  }
}
