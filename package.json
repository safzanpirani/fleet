{
  "name": "fleet",
  "version": "0.1.0",
  "description": "Drive your whole machine fleet over SSH without quoting pain",
  "type": "module",
  "bin": {
    "fleet": "./src/cli.ts",
    "fleet-mcp": "./src/mcp.ts",
    "fleet-mcp-http": "./src/http.ts"
  },
  "scripts": {
    "fleet": "bun run src/cli.ts",
    "mcp": "bun run src/mcp.ts",
    "serve": "bun run src/http.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/cli.ts --outfile dist/fleet-linux-x64",
    "build:local": "bun build --compile src/cli.ts --outfile dist/fleet-local"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
